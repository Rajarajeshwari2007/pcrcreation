# ---------------------------------------------------------------
#  Copy of this file is created for you by:  npm run setup
#  Never share your real ".env" file or upload it to GitHub.
# ---------------------------------------------------------------

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database ---
# Local MongoDB (default):
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio_admin
# MongoDB Atlas (cloud) looks like this - replace the whole line above with it:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/portfolio_admin?retryWrites=true&w=majority

# --- Security ---
# Filled in automatically by "npm run setup" (long random text used to sign login cookies).
JWT_SECRET=
# How many hours an admin login stays valid
SESSION_HOURS=2

# --- Your admin account (used only by "npm run seed") ---
# Password: at least 10 characters. Choose your own - do not keep an example!
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
